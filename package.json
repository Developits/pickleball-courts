{
  "name": "pickleball-courts",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist --d1=DB",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "node --test tests/*.test.js",
    "test:ui": "vitest run",
    "test:watch": "vitest",
    "test:api:watch": "node --test --watch tests/*.test.js",
    "test:tournaments:local": "node tests/tournament-local-d1.mjs && node tests/tournament-pages.mjs",
    "check:functions": "wrangler pages functions build --outdir=.wrangler/functions-build",
    "check": "npm run lint && npm run test && npm run build && npm run check:functions",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "tailwindcss": "^4.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "31.0.1",
    "vite": "^8.0.12",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.6"
    }
  }
}
